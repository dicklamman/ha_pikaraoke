+def create_ingress_test_app() -> Flask:
+    """An app with no configured base path, as the add-on runs it."""
+    app = Flask(__name__)
+    app.wsgi_app = BasePathMiddleware(app.wsgi_app, "")
+
+    @app.route("/hello")
+    def hello():
+        return jsonify(
+            {
+                "path": request.path,
+                "script_root": request.script_root,
+                "hello_url": url_for("hello"),
+            }
+        )
+
+    return app
+
+
+def test_ingress_path_is_read_from_the_header():
+    assert get_ingress_path({"HTTP_X_INGRESS_PATH": "/api/hassio_ingress/tok"}) == (
+        "/api/hassio_ingress/tok"
+    )
+    assert get_ingress_path({}) == ""
+    assert get_ingress_path({"HTTP_X_INGRESS_PATH": ""}) == ""
+
+
+def test_ingress_prefix_keeps_paths_relative_and_urls_prefixed():
+    """The Supervisor strips the Ingress prefix before the request arrives.
+
+    So the path must stay relative for routing and auth checks, while the
+    generated URLs carry the prefix the browser actually uses.
+    """
+    app = create_ingress_test_app()
+    client = app.test_client()
+
+    response = client.get(
+        "/hello",
+        headers={"X-Ingress-Path": "/api/hassio_ingress/tok123"},
+    )
+
+    assert response.status_code == 200
+    assert response.get_json() == {
+        "path": "/hello",
+        "script_root": "/api/hassio_ingress/tok123",
+        "hello_url": "/api/hassio_ingress/tok123/hello",
+    }
+
+
+def test_ingress_prefix_is_ignored_without_the_header():
+    app = create_ingress_test_app()
+    client = app.test_client()
+
+    response = client.get("/hello")
+
+    assert response.status_code == 200
+    assert response.get_json()["script_root"] == ""
+    assert response.get_json()["hello_url"] == "/hello"
+
+
 def test_static_file_urls_work_with_base_path():
     """Test that static file URLs are generated correctly with base path."""
     app = create_prefixed_test_app()
