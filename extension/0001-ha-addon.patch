diff --git a/pikaraoke/lib/discovery.py b/pikaraoke/lib/discovery.py
new file mode 100644
index 0000000..8bd5a58
--- /dev/null
+++ b/pikaraoke/lib/discovery.py
@@ -0,0 +1,130 @@
+"""Answer a "who is the PiKaraoke server?" question over UDP.
+
+A player that is not told where the server is has to find it. The obvious
+answer, a web page with an address in it, needs a keyboard, which a television
+does not have. So the server answers on UDP instead: a player broadcasts a
+short question on the discovery port and the server replies with where it
+lives.
+
+The reply carries the server's own idea of its address, which for a Home
+Assistant add-on is the host's address on the local network rather than the
+container's, because only the former can be reached from a phone.
+"""
+
+import json
+import logging
+import socket
+import threading
+
+# The question a player broadcasts, and the answer a server sends back. The
+# question is padded so that a server can recognise it in a packet that also
+# carries something else.
+DISCOVERY_REQUEST = b"PIKARAOKE_DISCOVER_V1"
+
+# The port a player is expected to try first. It matches the web port, so that
+# a player with nothing else to go on has one number to try.
+DEFAULT_DISCOVERY_PORT = 5555
+
+# How long to wait for a reply, and how many replies to collect before
+# stopping. Several servers may answer, and the first one is usually the one
+# closest to the player, but collecting a few costs nothing and lets the player
+# show a list.
+REPLY_TIMEOUT_SECONDS = 3.0
+
+# The UDP port is opened on the same number as the web port, so a port that is
+# already in use means something else has it.
+SOCKET_TIMEOUT_SECONDS = 1.0
+
+
+class DiscoveryResponder:
+    """Answers discovery broadcasts with the server's address.
+
+    The responder runs on its own thread and holds a socket bound to every
+    interface, so a player on the local network can reach it either by
+    broadcasting or by asking a known address directly.
+    """
+
+    def __init__(self, port: int, url: str, site_name: str = "PiKaraoke") -> None:
+        """Set up the responder.
+
+        Args:
+            port: The UDP port to answer on.
+            url: The address a player should open to reach the web interface.
+            site_name: The name to show for this server.
+        """
+        self.port = port
+        self.url = url
+        self.site_name = site_name
+        self._socket: socket.socket | None = None
+        self._thread: threading.Thread | None = None
+        self._stop = threading.Event()
+
+    def start(self) -> bool:
+        """Begin answering discovery requests.
+
+        Returns:
+            True if the responder is running, False if the port was not free.
+        """
+        if self._thread is not None:
+            return True
+
+        try:
+            sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
+            sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
+            # Replies are sent back to the address the question came from, which
+            # is often a broadcast address, so sending has to be allowed.
+            sock.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
+            sock.settimeout(SOCKET_TIMEOUT_SECONDS)
+            sock.bind(("0.0.0.0", self.port))
+        except OSError as e:
+            logging.warning(f"Could not open the discovery port {self.port}: {e}")
+            return False
+
+        self._socket = sock
+        self._thread = threading.Thread(target=self._serve, name="discovery", daemon=True)
+        self._thread.start()
+        logging.info(f"Answering discovery requests on UDP port {self.port}")
+        return True
+
+    def stop(self) -> None:
+        """Stop answering discovery requests."""
+        self._stop.set()
+        if self._socket is not None:
+            try:
+                self._socket.close()
+            except OSError:
+                pass
+            self._socket = None
+        self._thread = None
+
+    def _serve(self) -> None:
+        """Answer every question that arrives until the responder is stopped."""
+        while not self._stop.is_set():
+            sock = self._socket
+            if sock is None:
+                return
+            try:
+                data, address = sock.recvfrom(1024)
+            except socket.timeout:
+                continue
+            except OSError:
+                return
+
+            if DISCOVERY_REQUEST not in data:
+                continue
+
+            reply = self._build_reply()
+            try:
+                sock.sendto(reply, address)
+            except OSError as e:
+                logging.debug(f"Could not answer a discovery request from {address}: {e}")
+
+    def _build_reply(self) -> bytes:
+        """Build the answer a player reads."""
+        payload = {
+            "name": self.site_name,
+            "url": self.url,
+            "port": self.port,
+            "app": "pikaraoke",
+        }
+        return json.dumps(payload).encode("utf-8")
