@@ -0,0 +1,180 @@
+"""Fetch synchronized lyrics for a downloaded song as an ASS sidecar file.
+
+PiKaraoke renders an .ass file that sits next to the song file under the same
+base name, so a downloaded song carries its own lyrics onto the player.
+
+The captions come from YouTube itself: yt-dlp lists the tracks a video has,
+and the best one is converted to ASS. Human-authored captions are preferred
+over automatic ones, and the video's own language over a translation.
+"""
+
+import json
+import logging
+import os
+import shutil
+import subprocess
+import tempfile
+
+from pikaraoke.lib.ytdlp_binary import ytdlp_command
+
+# How many caption tracks to try before giving up. Each attempt is a separate
+# yt-dlp run, so the cap keeps a video whose captions cannot be reached from
+# stalling the download queue.
+MAX_TRACK_ATTEMPTS = 3
+
+# How long to wait for yt-dlp. The metadata query and the caption download are
+# both network calls against YouTube, which is slow more often than it is down.
+YTDL_TIMEOUT_SECONDS = 120
+
+# YouTube suffixes an uploader-authored track with the id of the caption set it
+# came from ("en-nP7-2PuUl7o"), and gives an automatic track of the original
+# language the suffix "-orig".
+_ORIG_SUFFIX = "-orig"
+
+
+def _base_language(code: str) -> str:
+    """The language part of a caption code, without YouTube's caption-set id."""
+    return code.split("-")[0]
+
+
+def _read_info(video_url: str) -> dict:
+    """Return yt-dlp's metadata for a video, or an empty dict on failure.
+
+    The metadata is what says which caption tracks exist, so a video without it
+    has nothing to pick from.
+    """
+    cmd = ytdlp_command() + ["-J", "--skip-download", video_url]
+    try:
+        result = subprocess.run(
+            cmd, capture_output=True, text=True, timeout=YTDL_TIMEOUT_SECONDS, check=True
+        )
+    except (subprocess.SubprocessError, OSError) as e:
+        logging.warning("Could not read caption metadata for %s: %s", video_url, e)
+        return {}
+    try:
+        info = json.loads(result.stdout)
+    except ValueError:
+        logging.warning("yt-dlp returned unreadable caption metadata for %s", video_url)
+        return {}
+    if isinstance(info, list):
+        info = info[0] if info else {}
+    return info if isinstance(info, dict) else {}
+
+
+def candidate_tracks(info: dict) -> list[tuple[str, bool]]:
+    """Caption tracks to try, best first, as (language code, is automatic).
+
+    Human-authored captions come first because they are the accurate ones, and
+    the video's own language comes before English, so a song is not sung over a
+    translation of itself.
+
+    Only the original-language automatic track is considered. YouTube offers
+    machine translations of that track in a hundred-odd other languages, and a
+    translated lyric sheet is worse than no lyric sheet.
+    """
+    manual = info.get("subtitles") or {}
+    automatic = info.get("automatic_captions") or {}
+    original = info.get("language") or ""
+
+    candidates: list[tuple[str, bool]] = []
+
+    def add(code: str, is_automatic: bool) -> None:
+        if not code:
+            return
+        available = automatic if is_automatic else manual
+        if code in available and (code, is_automatic) not in candidates:
+            candidates.append((code, is_automatic))
+
+    # Human captions in the language the song is sung in.
+    for code in manual:
+        if original and _base_language(code) == original:
+            add(code, False)
+
+    # The automatic track of the original language.
+    if original:
+        add(f"{original}{_ORIG_SUFFIX}", True)
+    else:
+        for code in automatic:
+            if code.endswith(_ORIG_SUFFIX):
+                add(code, True)
+
+    # Human captions in English, for a song whose own language has none.
+    for code in manual:
+        if _base_language(code) == "en":
+            add(code, False)
+
+    # Any other human captions are still a real lyric sheet.
+    for code in manual:
+        add(code, False)
+
+    return candidates
+
+
+def _fetch_track(video_url: str, code: str, is_automatic: bool, workdir: str) -> str | None:
+    """Download one caption track as ASS into workdir, returning its path.
+
+    Returns None when the track could not be fetched, which is the common case
+    for a track YouTube stops serving. One language per run: yt-dlp converts
+    captions only after every requested language is in, so a single language
+    that fails would cost the others their conversion too.
+    """
+    cmd = ytdlp_command() + [
+        "--skip-download",
+        "--write-auto-subs" if is_automatic else "--write-subs",
+        "--sub-langs",
+        code,
+        "--convert-subs",
+        "ass",
+        "-o",
+        os.path.join(workdir, "%(id)s.%(ext)s"),
+        video_url,
+    ]
+    try:
+        subprocess.run(
+            cmd, capture_output=True, text=True, timeout=YTDL_TIMEOUT_SECONDS, check=True
+        )
+    except (subprocess.SubprocessError, OSError) as e:
+        logging.warning("Could not fetch %s captions for %s: %s", code, video_url, e)
+        return None
+
+    try:
+        converted = [f for f in os.listdir(workdir) if f.endswith(".ass")]
+    except OSError:
+        return None
+    if not converted:
+        return None
+    return os.path.join(workdir, converted[0])
+
+
+def fetch_lyrics(video_url: str, song_path: str) -> str | None:
+    """Save lyrics for a downloaded song next to it as an .ass file.
+
+    Returns the path of the .ass file, or None when the video has no reachable
+    captions. Never raises: a song without lyrics is still a playable song.
+    """
+    target = os.path.splitext(song_path)[0] + ".ass"
+    if os.path.exists(target):
+        return target
+
+    tracks = candidate_tracks(_read_info(video_url))
+    if not tracks:
+        logging.info("No caption tracks available for %s", video_url)
+        return None
+
+    workdir = tempfile.mkdtemp(prefix="pikaraoke-lyrics-")
+    try:
+        for code, is_automatic in tracks[:MAX_TRACK_ATTEMPTS]:
+            source = _fetch_track(video_url, code, is_automatic, workdir)
+            if source is None:
+                continue
+            shutil.move(source, target)
+            logging.info("Saved lyrics for %s to %s", song_path, target)
+            return target
+    except OSError as e:
+        logging.warning("Could not save lyrics for %s: %s", song_path, e)
+        return None
+    finally:
+        shutil.rmtree(workdir, ignore_errors=True)
+
+    logging.info("No lyrics could be fetched for %s", video_url)
+    return None
