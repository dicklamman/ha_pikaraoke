+"""Unit tests for the lyrics module."""
+
+import json
+import os
+import subprocess
+import sys
+from unittest.mock import patch
+
+import pytest
+
+from pikaraoke.lib.lyrics import (
+    MAX_TRACK_ATTEMPTS,
+    candidate_tracks,
+    fetch_lyrics,
+)
+
+URL = "https://www.youtube.com/watch?v=dQw4w9WgXcQ"
+
+
+@pytest.fixture(autouse=True)
+def _module_ytdlp_command():
+    """Pin yt-dlp invocation to the module so command assertions stay hermetic."""
+    with patch(
+        "pikaraoke.lib.lyrics.ytdlp_command",
+        return_value=[sys.executable, "-m", "yt_dlp"],
+    ):
+        yield
+
+
+def _info(language="en", manual=None, automatic=None) -> dict:
+    """Build the metadata shape yt-dlp reports for a video."""
+    return {
+        "language": language,
+        "subtitles": manual or {},
+        "automatic_captions": automatic or {},
+    }
+
+
+class TestCandidateTracks:
+    """Tests for choosing which caption track to fetch."""
+
+    def test_manual_captions_come_first(self):
+        tracks = candidate_tracks(_info(manual={"en": []}, automatic={"en-orig": []}))
+
+        assert tracks[0] == ("en", False)
+
+    def test_the_original_language_beats_english(self):
+        tracks = candidate_tracks(_info(language="ja", manual={"en": [], "ja": []}))
+
+        assert tracks[0] == ("ja", False)
+
+    def test_a_caption_set_id_does_not_hide_the_language(self):
+        """YouTube suffixes an uploader's track with the id of its caption set."""
+        tracks = candidate_tracks(_info(language="ko", manual={"ko-nP7-2PuUl7o": []}))
+
+        assert tracks[0] == ("ko-nP7-2PuUl7o", False)
+
+    def test_the_original_captions_beat_english_ones(self):
+        tracks = candidate_tracks(_info(language="ja", manual={"en": []}, automatic={"ja-orig": []}))
+
+        assert tracks[0] == ("ja-orig", True)
+
+    def test_machine_translations_are_not_offered(self):
+        """YouTube offers translations of the original track in a hundred-odd languages.
+
+        A translated lyric sheet is worse than none, so only the original
+        language's automatic track is considered.
+        """
+        tracks = candidate_tracks(
+            _info(language="ko", automatic={"ko-orig": [], "en": [], "de": [], "fr": []})
+        )
+
+        assert ("en", True) not in tracks
+        assert ("de", True) not in tracks
+        assert ("fr", True) not in tracks
+
+    def test_english_is_used_when_there_is_no_original_language(self):
+        tracks = candidate_tracks(_info(language=None, manual={"en-nP7-2PuUl7o": []}))
+
+        assert tracks[0] == ("en-nP7-2PuUl7o", False)
+
+    def test_the_original_track_is_found_without_a_language(self):
+        """A video that reports no language still names its original track."""
+        tracks = candidate_tracks(_info(language=None, automatic={"ko-orig": [], "en": []}))
+
+        assert tracks[0] == ("ko-orig", True)
+
+    def test_a_video_without_captions_offers_nothing(self):
+        assert candidate_tracks(_info()) == []
+
+    def test_the_same_track_is_not_offered_twice(self):
+        tracks = candidate_tracks(
+            _info(language="en", manual={"en": []}, automatic={"en-orig": [], "en": []})
+        )
+
+        assert len(tracks) == len(set(tracks))
+
+
+class TestFetchLyrics:
+    """Tests for saving captions next to the song."""
+
+    @staticmethod
+    def _metadata(stdout: str):
+        """A completed yt-dlp metadata query."""
+
+        def run(cmd, **kwargs):
+            return subprocess.CompletedProcess(cmd, 0, stdout=stdout, stderr="")
+
+        return run
+
+    def test_saves_the_caption_next_to_the_song(self, tmp_path):
+        song = tmp_path / "Song---dQw4w9WgXcQ.mp4"
+        song.write_bytes(b"video")
+
+        def run(cmd, **kwargs):
+            if "-J" in cmd:
+                return subprocess.CompletedProcess(
+                    cmd, 0, stdout=json.dumps(_info(manual={"en": []})), stderr=""
+                )
+            workdir = os.path.dirname(cmd[cmd.index("-o") + 1])
+            with open(os.path.join(workdir, "dQw4w9WgXcQ.en.ass"), "w", encoding="utf-8") as f:
+                f.write("[Events]\n")
+            return subprocess.CompletedProcess(cmd, 0, stdout="", stderr="")
+
+        with patch("pikaraoke.lib.lyrics.subprocess.run", side_effect=run):
+            result = fetch_lyrics(URL, str(song))
+
+        assert result == str(tmp_path / "Song---dQw4w9WgXcQ.ass")
+        assert os.path.exists(result)
+
+    def test_an_existing_lyric_file_is_left_alone(self, tmp_path):
+        song = tmp_path / "Song---dQw4w9WgXcQ.mp4"
+        song.write_bytes(b"video")
+        existing = tmp_path / "Song---dQw4w9WgXcQ.ass"
+        existing.write_text("mine", encoding="utf-8")
+
+        with patch("pikaraoke.lib.lyrics.subprocess.run") as mock_run:
+            result = fetch_lyrics(URL, str(song))
+
+        assert result == str(existing)
+        assert existing.read_text(encoding="utf-8") == "mine"
+        mock_run.assert_not_called()
+
+    def test_a_video_without_captions_yields_nothing(self, tmp_path):
+        song = tmp_path / "Song---dQw4w9WgXcQ.mp4"
+        song.write_bytes(b"video")
+
+        with patch(
+            "pikaraoke.lib.lyrics.subprocess.run",
+            return_value=subprocess.CompletedProcess([], 0, stdout=json.dumps(_info()), stderr=""),
+        ):
+            result = fetch_lyrics(URL, str(song))
+
+        assert result is None
+        assert not os.path.exists(tmp_path / "Song---dQw4w9WgXcQ.ass")
+
+    def test_a_failing_yt_dlp_yields_nothing(self, tmp_path):
+        song = tmp_path / "Song---dQw4w9WgXcQ.mp4"
+        song.write_bytes(b"video")
+
+        def run(cmd, **kwargs):
+            if "-J" in cmd:
+                return subprocess.CompletedProcess(
+                    cmd, 0, stdout=json.dumps(_info(manual={"en": []})), stderr=""
+                )
+            raise subprocess.CalledProcessError(1, cmd)
+
+        with patch("pikaraoke.lib.lyrics.subprocess.run", side_effect=run):
+            result = fetch_lyrics(URL, str(song))
+
+        assert result is None
+
+    def test_unreadable_metadata_yields_nothing(self, tmp_path):
+        song = tmp_path / "Song---dQw4w9WgXcQ.mp4"
+        song.write_bytes(b"video")
+
+        with patch(
+            "pikaraoke.lib.lyrics.subprocess.run",
+            return_value=subprocess.CompletedProcess([], 0, stdout="not json", stderr=""),
+        ):
+            result = fetch_lyrics(URL, str(song))
+
+        assert result is None
+
+    def test_only_a_few_tracks_are_tried(self, tmp_path):
+        """A video whose captions cannot be reached must not stall the queue."""
+        song = tmp_path / "Song---dQw4w9WgXcQ.mp4"
+        song.write_bytes(b"video")
+        calls = []
+
+        def run(cmd, **kwargs):
+            if "-J" in cmd:
+                return subprocess.CompletedProcess(
+                    cmd,
+                    0,
+                    stdout=json.dumps(
+                        _info(language=None, automatic={f"l{i}-orig": [] for i in range(10)})
+                    ),
+                    stderr="",
+                )
+            calls.append(cmd)
+            raise subprocess.CalledProcessError(1, cmd)
+
+        with patch("pikaraoke.lib.lyrics.subprocess.run", side_effect=run):
+            result = fetch_lyrics(URL, str(song))
+
+        assert result is None
+        assert len(calls) == MAX_TRACK_ATTEMPTS
