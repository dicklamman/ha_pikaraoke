diff --git a/pikaraoke/lib/ha_network.py b/pikaraoke/lib/ha_network.py
new file mode 100644
index 0000000..4049ba3
--- /dev/null
+++ b/pikaraoke/lib/ha_network.py
@@ -0,0 +1,226 @@
+"""Resolve the Home Assistant host's LAN address from inside an add-on.
+
+An add-on runs in a container on the Supervisor's internal Docker network, so
+the address PiKaraoke detects for itself is something like 172.30.33.12. That
+address only means anything inside Home Assistant: a phone on the same network
+as the host cannot reach it, so the QR code on the splash screen leads nowhere.
+
+The Supervisor knows the address the host actually has on the network, so ask
+it for that instead. Outside Home Assistant there is no Supervisor to ask, and
+the caller keeps whatever it detected itself.
+"""
+
+import ipaddress
+import logging
+import os
+
+import requests
+
+# The Supervisor is reachable from an add-on container under this name.
+SUPERVISOR_URL = "http://supervisor"
+
+# The endpoint that lists the host's network interfaces.
+NETWORK_INFO_PATH = "/network/info"
+
+# The Supervisor is local, so this only has to cover a slow answer.
+REQUEST_TIMEOUT_SECONDS = 5
+
+# An address in one of these ranges is not reachable from the network the
+# host is on: the first is the container's own loopback, the second is the
+# link-local range that has no route off the machine.
+_UNUSABLE_PREFIXES = ("127.", "169.254.")
+
+
+def _first_usable_address(addresses: object) -> str | None:
+    """Return the first IPv4 address in a Supervisor address list.
+
+    The Supervisor reports addresses with their prefix length ("192.168.1.10/24"),
+    which has to be stripped to get the bare address.
+
+    Args:
+        addresses: The address list from the Supervisor, or a single address.
+
+    Returns:
+        The bare IPv4 address, or None if the list holds no usable one.
+    """
+    if isinstance(addresses, str):
+        addresses = [addresses]
+    if not isinstance(addresses, (list, tuple)):
+        return None
+
+    for address in addresses:
+        if not isinstance(address, str):
+            continue
+        bare = address.split("/")[0].strip()
+        if not bare or bare.startswith(_UNUSABLE_PREFIXES):
+            continue
+        return bare
+    return None
+
+
+def _ipv4_block(interface: dict) -> dict:
+    """Return the IPv4 block of a Supervisor interface.
+
+    The Supervisor's v1 API reports the block directly on the interface, while
+    v2 nests it under the interface's state.
+
+    Args:
+        interface: One entry of the Supervisor's interface list.
+
+    Returns:
+        The IPv4 block, or an empty dict when the interface has none.
+    """
+    block = interface.get("ipv4")
+    if isinstance(block, dict):
+        return block
+    state = interface.get("state")
+    if isinstance(state, dict):
+        block = state.get("ipv4")
+        if isinstance(block, dict):
+            return block
+    return {}
+
+
+def _docker_network(payload: dict) -> ipaddress.IPv4Network | None:
+    """Return the Supervisor's internal Docker network, if the payload names one.
+
+    An address inside that network belongs to the container network rather than
+    to the network the host is on, so it is not an address a client can use.
+
+    Args:
+        payload: The decoded body of a Supervisor network info response.
+
+    Returns:
+        The Docker network, or None when the payload does not name one.
+    """
+    docker = payload.get("docker")
+    if not isinstance(docker, dict):
+        return None
+    address = docker.get("address")
+    if not isinstance(address, str):
+        return None
+    try:
+        return ipaddress.ip_network(address, strict=False)
+    except ValueError:
+        return None
+
+
+def _is_usable(address: str, docker_network: ipaddress.IPv4Network | None) -> bool:
+    """Say whether an address can be reached from the network the host is on.
+
+    Args:
+        address: The bare IPv4 address to check.
+        docker_network: The Supervisor's internal Docker network, if known.
+
+    Returns:
+        True when the address is one a client on the network could use.
+    """
+    if address.startswith(_UNUSABLE_PREFIXES):
+        return False
+    if docker_network is None:
+        return True
+    try:
+        return ipaddress.ip_address(address) not in docker_network
+    except ValueError:
+        return False
+
+
+def unwrap_response(body: object) -> dict | None:
+    """Return the payload of a Supervisor API response.
+
+    The Supervisor wraps every answer in an envelope: the payload itself sits
+    under "data", with "result" saying whether the call succeeded. A caller
+    that looks for the payload at the top level finds nothing and concludes the
+    host has no usable address, which leaves the add-on showing its own
+    container address instead.
+
+    Args:
+        body: The decoded body of a Supervisor response.
+
+    Returns:
+        The payload, or None when the body is not a usable response.
+    """
+    if not isinstance(body, dict):
+        return None
+
+    # A response that carries "result" is an envelope, so the payload is under
+    # "data". A body without one is the payload itself, which keeps this
+    # working against a Supervisor that answers with the bare object.
+    if "result" in body:
+        if body.get("result") != "ok":
+            return None
+        data = body.get("data")
+        return data if isinstance(data, dict) else None
+
+    return body
+
+
+def select_lan_ip(payload: dict) -> str | None:
+    """Pick the host's LAN address out of a Supervisor network info response.
+
+    The primary interface is the one the host routes its traffic through, so it
+    is the address clients on the network use.
+
+    Args:
+        payload: The decoded body of a Supervisor network info response.
+
+    Returns:
+        The LAN address, or None when the payload holds no usable one.
+    """
+    interfaces = payload.get("interfaces")
+    if not isinstance(interfaces, list):
+        return None
+
+    docker_network = _docker_network(payload)
+
+    fallback: str | None = None
+    for interface in interfaces:
+        if not isinstance(interface, dict):
+            continue
+        block = _ipv4_block(interface)
+        address = _first_usable_address(block.get("addresses") or block.get("address"))
+        if not address or not _is_usable(address, docker_network):
+            continue
+        if interface.get("primary"):
+            return address
+        if fallback is None:
+            fallback = address
+
+    return fallback
+
+
+def get_supervisor_lan_ip() -> str | None:
+    """Return the LAN address of the Home Assistant host, if there is one.
+
+    Returns:
+        The host's LAN address, or None when this is not running as a Home
+        Assistant add-on, or the Supervisor does not report a usable address.
+    """
+    token = os.environ.get("SUPERVISOR_TOKEN")
+    if not token:
+        return None
+
+    try:
+        response = requests.get(
+            SUPERVISOR_URL + NETWORK_INFO_PATH,
+            headers={"Authorization": f"Bearer {token}"},
+            timeout=REQUEST_TIMEOUT_SECONDS,
+        )
+        response.raise_for_status()
+        body = response.json()
+    except requests.RequestException as e:
+        logging.warning(f"Could not read the host network info from the Supervisor: {e}")
+        return None
+    except ValueError as e:
+        logging.warning(f"The Supervisor returned network info that is not JSON: {e}")
+        return None
+
+    payload = unwrap_response(body)
+    if payload is None:
+        logging.warning("The Supervisor returned network info in an unexpected shape.")
+        return None
+
+    address = select_lan_ip(payload)
+    if address is None:
+        logging.warning("The Supervisor reported no usable address for the host.")
+    return address
