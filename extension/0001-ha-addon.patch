+"""Unit tests for the Home Assistant host network module."""
+
+from unittest.mock import MagicMock, patch
+
+import requests
+
+from pikaraoke.lib.ha_network import (
+    get_supervisor_lan_ip,
+    select_lan_ip,
+)
+
+
+def _v1_payload(address="192.168.0.10/24", primary=True):
+    """A Supervisor v1 network info payload."""
+    return {
+        "interfaces": [
+            {
+                "interface": "eth0",
+                "type": "ethernet",
+                "primary": primary,
+                "ipv4": {"address": [address]},
+            }
+        ],
+        "docker": {"interface": "hassio", "address": "172.30.32.0/23"},
+    }
+
+
+def _v2_payload(address="192.168.0.10/24", primary=True):
+    """A Supervisor v2 network info payload."""
+    return {
+        "interfaces": [
+            {
+                "name": "eth0",
+                "type": "ethernet",
+                "primary": primary,
+                "state": {"ipv4": {"addresses": [address]}},
+            }
+        ],
+        "docker": {"interface": "hassio", "address": "172.30.32.0/23"},
+    }
+
+
+class TestSelectLanIp:
+    """Tests for picking the host address out of a Supervisor response."""
+
+    def test_prefers_the_primary_interface(self):
+        """The primary interface is the one the host routes traffic through."""
+        payload = {
+            "interfaces": [
+                {"interface": "wlan0", "primary": False, "ipv4": {"address": ["10.0.0.5/24"]}},
+                {"interface": "eth0", "primary": True, "ipv4": {"address": ["192.168.0.10/24"]}},
+            ]
+        }
+        assert select_lan_ip(payload) == "192.168.0.10"
+
+    def test_falls_back_to_any_interface(self):
+        """Without a primary interface, any usable address will do."""
+        payload = {
+            "interfaces": [
+                {"interface": "wlan0", "primary": False, "ipv4": {"address": ["10.0.0.5/24"]}}
+            ]
+        }
+        assert select_lan_ip(payload) == "10.0.0.5"
+
+    def test_reads_the_v2_payload_shape(self):
+        """The v2 API nests the addresses under the interface state."""
+        assert select_lan_ip(_v2_payload()) == "192.168.0.10"
+
+    def test_reads_the_v1_payload_shape(self):
+        """The v1 API puts the addresses directly on the interface."""
+        assert select_lan_ip(_v1_payload()) == "192.168.0.10"
+
+    def test_strips_the_prefix_length(self):
+        """The Supervisor reports addresses with their prefix length."""
+        assert select_lan_ip(_v1_payload(address="192.168.0.10/24")) == "192.168.0.10"
+
+    def test_ignores_loopback_and_link_local_addresses(self):
+        """Neither loopback nor link-local addresses can be reached."""
+        payload = {
+            "interfaces": [
+                {"interface": "lo", "primary": True, "ipv4": {"address": ["127.0.0.1/8"]}},
+                {
+                    "interface": "eth0",
+                    "primary": False,
+                    "ipv4": {"address": ["169.254.1.1/16"]},
+                },
+            ]
+        }
+        assert select_lan_ip(payload) is None
+
+    def test_returns_none_without_interfaces(self):
+        """A response without interfaces holds no address."""
+        assert select_lan_ip({"docker": {}}) is None
+
+    def test_returns_none_for_a_broken_payload(self):
+        """A payload that is not shaped like a response holds no address."""
+        assert select_lan_ip({"interfaces": "not a list"}) is None
+
+
+class TestGetSupervisorLanIp:
+    """Tests for asking the Supervisor for the host address."""
+
+    def test_returns_the_host_address(self):
+        """The host address is taken from the Supervisor's response."""
+        response = MagicMock()
+        response.json.return_value = _v1_payload()
+
+        with patch.dict("os.environ", {"SUPERVISOR_TOKEN": "secret"}):
+            with patch("requests.get", return_value=response) as mock_get:
+                assert get_supervisor_lan_ip() == "192.168.0.10"
+
+        _, kwargs = mock_get.call_args
+        assert kwargs["headers"]["Authorization"] == "Bearer secret"
+
+    def test_returns_none_outside_home_assistant(self):
+        """Without a Supervisor token there is nothing to ask."""
+        with patch.dict("os.environ", {}, clear=True):
+            assert get_supervisor_lan_ip() is None
+
+    def test_returns_none_when_the_supervisor_is_unreachable(self):
+        """A Supervisor that cannot be reached leaves the caller to decide."""
+        with patch.dict("os.environ", {"SUPERVISOR_TOKEN": "secret"}):
+            with patch("requests.get", side_effect=requests.ConnectionError("no route")):
+                assert get_supervisor_lan_ip() is None
+
+    def test_returns_none_on_an_error_response(self):
+        """An error response holds no address."""
+        response = MagicMock()
+        response.raise_for_status.side_effect = requests.HTTPError("403")
+
+        with patch.dict("os.environ", {"SUPERVISOR_TOKEN": "secret"}):
+            with patch("requests.get", return_value=response):
+                assert get_supervisor_lan_ip() is None
+
+    def test_returns_none_on_unreadable_json(self):
+        """A response that is not JSON holds no address."""
+        response = MagicMock()
+        response.json.side_effect = ValueError("not json")
+
+        with patch.dict("os.environ", {"SUPERVISOR_TOKEN": "secret"}):
+            with patch("requests.get", return_value=response):
+                assert get_supervisor_lan_ip() is None
+
+
+class TestKaraokeUrl:
+    """Tests for the address PiKaraoke puts in the URL it shows."""
+
+    def _karaoke_stub(self):
+        """A stand-in for the parts of Karaoke that get_url() touches."""
+        from types import SimpleNamespace
+
+        return SimpleNamespace(
+            is_raspberry_pi=False,
+            platform="linux",
+            port=5555,
+            url_override=None,
+            prefer_hostname=False,
+            url_base_path="",
+        )
+
+    def test_uses_the_host_address_instead_of_the_container_address(self):
+        """The container address is unreachable from the network."""
+        from pikaraoke.karaoke import Karaoke
+
+        k = self._karaoke_stub()
+
+        with patch("pikaraoke.karaoke.get_ip", return_value="172.30.33.12"):
+            with patch("pikaraoke.karaoke.get_supervisor_lan_ip", return_value="192.168.0.10"):
+                assert Karaoke.get_url(k) == "http://192.168.0.10:5555"
+
+    def test_keeps_the_detected_address_outside_home_assistant(self):
+        """Without a Supervisor there is nothing better than the detected address."""
+        from pikaraoke.karaoke import Karaoke
+
+        k = self._karaoke_stub()
+
+        with patch("pikaraoke.karaoke.get_ip", return_value="192.168.0.20"):
+            with patch("pikaraoke.karaoke.get_supervisor_lan_ip", return_value=None):
+                assert Karaoke.get_url(k) == "http://192.168.0.20:5555"
+
+    def test_an_explicit_url_still_wins(self):
+        """A URL set by hand is what the user asked for."""
+        from pikaraoke.karaoke import Karaoke
+
+        k = self._karaoke_stub()
+        k.url_override = "http://192.168.0.99:5555"
+
+        with patch("pikaraoke.karaoke.get_ip", return_value="172.30.33.12"):
+            with patch("pikaraoke.karaoke.get_supervisor_lan_ip", return_value="192.168.0.10"):
+                assert Karaoke.get_url(k) == "http://192.168.0.99:5555"
