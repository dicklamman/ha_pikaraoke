+class TestSearchCache:
+    """The result cache: the same question is not asked of YouTube twice."""
+
+    def test_a_repeat_query_is_served_from_the_cache(self):
+        from pikaraoke.lib.search_cache import SearchCache
+
+        cache = SearchCache()
+        cache.put("abba", [MISSING])
+        assert cache.get("abba") == [MISSING]
+
+    def test_an_unknown_query_misses(self):
+        from pikaraoke.lib.search_cache import SearchCache
+
+        assert SearchCache().get("abba") is None
+
+    def test_an_expired_entry_misses(self):
+        from pikaraoke.lib.search_cache import SearchCache
+
+        now = [0.0]
+        cache = SearchCache(ttl_seconds=10, clock=lambda: now[0])
+        cache.put("abba", [MISSING])
+
+        now[0] = 11.0
+        assert cache.get("abba") is None
+
+    def test_the_oldest_entry_is_evicted(self):
+        from pikaraoke.lib.search_cache import SearchCache
+
+        cache = SearchCache(max_entries=2)
+        cache.put("one", [MISSING])
+        cache.put("two", [MISSING])
+        cache.put("three", [MISSING])
+
+        assert cache.get("one") is None
+        assert cache.get("three") == [MISSING]
+
+    def test_a_hit_refreshes_the_entry(self):
+        """A query in use should not be the next one evicted."""
+        from pikaraoke.lib.search_cache import SearchCache
+
+        cache = SearchCache(max_entries=2)
+        cache.put("one", [MISSING])
+        cache.put("two", [MISSING])
+        cache.get("one")
+        cache.put("three", [MISSING])
+
+        assert cache.get("one") == [MISSING]
+        assert cache.get("two") is None
+
