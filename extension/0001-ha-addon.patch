diff --git a/tests/unit/test_discovery.py b/tests/unit/test_discovery.py
new file mode 100644
index 0000000..df303af
--- /dev/null
+++ b/tests/unit/test_discovery.py
@@ -0,0 +1,89 @@
+"""Unit tests for the discovery responder."""
+
+import json
+import socket
+
+from pikaraoke.lib.discovery import (
+    DEFAULT_DISCOVERY_PORT,
+    DISCOVERY_REQUEST,
+    DiscoveryResponder,
+)
+
+
+def _free_udp_port() -> int:
+    """A UDP port nothing is listening on.
+
+    The responder binds to the same port number as the web server, which is
+    allowed because TCP and UDP ports are separate. UDP has no connection to
+    refuse the bind, so the port is found by taking one and letting it go.
+    """
+    probe = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
+    try:
+        probe.bind(("0.0.0.0", 0))
+        return probe.getsockname()[1]
+    finally:
+        probe.close()
+
+
+class TestDiscoveryResponder:
+    """Tests for answering discovery requests."""
+
+    def test_answers_a_discovery_request(self):
+        """A player that asks gets the server's address back."""
+        port = _free_udp_port()
+        responder = DiscoveryResponder(port=port, url="http://192.168.0.10:5555")
+        assert responder.start()
+        try:
+            client = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
+            client.settimeout(3.0)
+            try:
+                client.sendto(DISCOVERY_REQUEST, ("127.0.0.1", port))
+                data, _ = client.recvfrom(4096)
+            finally:
+                client.close()
+        finally:
+            responder.stop()
+
+        payload = json.loads(data.decode())
+        assert payload["url"] == "http://192.168.0.10:5555"
+        assert payload["port"] == port
+        assert payload["app"] == "pikaraoke"
+
+    def test_ignores_a_packet_that_is_not_a_request(self):
+        """A packet that is not a question is not answered."""
+        port = _free_udp_port()
+        responder = DiscoveryResponder(port=port, url="http://192.168.0.10:5555")
+        assert responder.start()
+        try:
+            client = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
+            client.settimeout(1.0)
+            try:
+                client.sendto(b"something else entirely", ("127.0.0.1", port))
+                with _expect_timeout():
+                    client.recvfrom(4096)
+            finally:
+                client.close()
+        finally:
+            responder.stop()
+
+    def test_stopping_twice_is_harmless(self):
+        """Stopping a responder that is not running does nothing."""
+        responder = DiscoveryResponder(port=0, url="http://192.168.0.10:5555")
+        responder.stop()
+        responder.stop()
+
+    def test_the_discovery_port_matches_the_web_port(self):
+        """A player with one number to try tries the right one."""
+        assert DEFAULT_DISCOVERY_PORT == 5555
+
+
+class _expect_timeout:
+    """Context manager that swallows a socket timeout."""
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, exc_type, exc, tb):
+        if exc_type is None:
+            raise AssertionError("expected the socket to time out")
+        return issubclass(exc_type, socket.timeout)
