@@ -0,0 +1,80 @@
+"""A short-lived cache of YouTube search results.
+
+The Add New page is rendered from scratch every time it is visited, and a
+YouTube search costs seconds of yt-dlp work and a round trip to YouTube. This
+holds the most recent searches so that returning to the page is instant and
+does not ask YouTube the same question twice.
+
+In-memory and per-process on purpose: the results are a convenience, not
+state worth persisting, and a host restart clearing them is the intended
+reset.
+"""
+
+from __future__ import annotations
+
+import threading
+import time
+from collections import OrderedDict
+from collections.abc import Callable
+
+from pikaraoke.lib.youtube_dl import SearchResult
+
+# Long enough that a song hunt is not re-run for every trip to another menu,
+# short enough that a fresh hunt is not served stale results for hours.
+DEFAULT_TTL_SECONDS = 600.0
+
+# A handful of searches: enough for a party, few enough that a long evening
+# of hunting cannot grow this without bound.
+DEFAULT_MAX_ENTRIES = 16
+
+
+class SearchCache:
+    """Holds recent search results until they expire.
+
+    Keyed by the query actually sent to YouTube, so the same term searched with
+    and without non-karaoke matches keeps two entries.
+    """
+
+    def __init__(
+        self,
+        ttl_seconds: float = DEFAULT_TTL_SECONDS,
+        max_entries: int = DEFAULT_MAX_ENTRIES,
+        clock: Callable[[], float] = time.monotonic,
+    ) -> None:
+        self._ttl = ttl_seconds
+        self._max = max_entries
+        self._clock = clock
+        # Newest last, so the oldest is the one evicted.
+        self._entries: OrderedDict[str, tuple[float, list[SearchResult]]] = OrderedDict()
+        self._lock = threading.Lock()
+
+    def get(self, query: str) -> list[SearchResult] | None:
+        """The results for a query, or None when there are none to serve.
+
+        An entry past its time is dropped rather than served: the caller asks
+        YouTube again and puts the fresh results back.
+        """
+        with self._lock:
+            entry = self._entries.get(query)
+            if entry is None:
+                return None
+            stored_at, results = entry
+            if self._clock() - stored_at > self._ttl:
+                del self._entries[query]
+                return None
+            # A hit is a use, so it is the last to be evicted.
+            self._entries.move_to_end(query)
+            return results
+
+    def put(self, query: str, results: list[SearchResult]) -> None:
+        """Remember the results for a query, dropping the oldest if need be."""
+        with self._lock:
+            self._entries[query] = (self._clock(), list(results))
+            self._entries.move_to_end(query)
+            while len(self._entries) > self._max:
+                self._entries.popitem(last=False)
+
+    def clear(self) -> None:
+        """Forget everything. Used when the library changes enough to matter."""
+        with self._lock:
+            self._entries.clear()
