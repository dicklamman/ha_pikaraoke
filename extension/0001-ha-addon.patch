+class TestQueueManagerShuffle:
+    """Test shuffling the order of the queued songs."""
+
+    def test_shuffle_keeps_every_song(self, queue_manager):
+        """Shuffling reorders the queue without losing or adding a song."""
+        for index in range(1, 6):
+            queue_manager.enqueue(f"/songs/song{index}---abc.mp4", "User1")
+
+        result = queue_manager.queue_shuffle()
+
+        assert result is True
+        assert len(queue_manager.queue) == 5
+        assert sorted(item["file"] for item in queue_manager.queue) == [
+            f"/songs/song{index}---abc.mp4" for index in range(1, 6)
+        ]
+
+    def test_shuffle_changes_the_order(self, queue_manager):
+        """A queue of several songs does not come back in its original order.
+
+        The shuffle is random, so the chance of the original order surviving is
+        one in a factorial; the order is checked against a handful of shuffles
+        rather than a single one, which would flake.
+        """
+        for index in range(1, 7):
+            queue_manager.enqueue(f"/songs/song{index}---abc.mp4", "User1")
+        original = [item["file"] for item in queue_manager.queue]
+
+        orders = set()
+        for _ in range(20):
+            queue_manager.queue_shuffle()
+            orders.add(tuple(item["file"] for item in queue_manager.queue))
+
+        assert len(orders) > 1, "the shuffle never changed the order"
+        assert tuple(original) not in orders
+
+    def test_shuffle_keeps_the_song_details(self, queue_manager):
+        """A song keeps its singer and its key when the order changes."""
+        queue_manager.enqueue("/songs/song1---abc.mp4", "User1")
+        queue_manager.enqueue("/songs/song2---def.mp4", "User2", semitones=3)
+
+        queue_manager.queue_shuffle()
+
+        by_file = {item["file"]: item for item in queue_manager.queue}
+        assert by_file["/songs/song1---abc.mp4"]["user"] == "User1"
+        assert by_file["/songs/song2---def.mp4"]["user"] == "User2"
+        assert by_file["/songs/song2---def.mp4"]["semitones"] == 3
+
+    def test_shuffle_of_an_empty_queue_reports_failure(self, queue_manager):
+        """There is nothing to shuffle in an empty queue."""
+        assert queue_manager.queue_shuffle() is False
+
+    def test_shuffle_of_one_song_reports_failure(self, queue_manager):
+        """One song has no order to change."""
+        queue_manager.enqueue("/songs/song1---abc.mp4", "User1")
+
+        assert queue_manager.queue_shuffle() is False
+        assert len(queue_manager.queue) == 1
+
+    def test_shuffle_emits_events(self, queue_manager):
+        """A successful shuffle should emit queue_update and now_playing_update."""
+        queue_manager.enqueue("/songs/song1---abc.mp4", "User1")
+        queue_manager.enqueue("/songs/song2---def.mp4", "User2")
+
+        queue_updates = []
+        now_playing_updates = []
+        queue_manager._events.on("queue_update", lambda: queue_updates.append(True))
+        queue_manager._events.on("now_playing_update", lambda: now_playing_updates.append(True))
+
+        queue_manager.queue_shuffle()
+
+        assert len(queue_updates) == 1
+        assert len(now_playing_updates) == 1
+
+    def test_shuffle_of_one_song_emits_nothing(self, queue_manager):
+        """A shuffle that changed nothing should not redraw the queue."""
+        queue_manager.enqueue("/songs/song1---abc.mp4", "User1")
+
+        queue_updates = []
+        queue_manager._events.on("queue_update", lambda: queue_updates.append(True))
+
+        queue_manager.queue_shuffle()
+
+        assert queue_updates == []
+
+
