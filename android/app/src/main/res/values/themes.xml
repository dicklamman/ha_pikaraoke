<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- A full-screen player: no action bar, and a black background so the
         splash screen's own dark theme meets the screen rather than a flash of
         white while the page loads. -->
    <style name="Theme.PiKaraoke" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>
