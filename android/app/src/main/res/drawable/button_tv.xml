<?xml version="1.0" encoding="utf-8"?>
<!-- A button that shows where the remote's focus is.

     On a television the focus is the only pointer there is, so the focused
     button has to look clearly different from the others, and has to be
     obvious from across a room. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_button_focused" />
            <corners android:radius="10dp" />
            <stroke
                android:width="3dp"
                android:color="@color/tv_button_focused_border" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_button_pressed" />
            <corners android:radius="10dp" />
            <stroke
                android:width="3dp"
                android:color="@color/tv_button_focused_border" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_button_background" />
            <corners android:radius="10dp" />
            <stroke
                android:width="2dp"
                android:color="@color/tv_button_border" />
        </shape>
    </item>
</selector>
