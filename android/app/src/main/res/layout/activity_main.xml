<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- The splash screen, served by the PiKaraoke server. -->
    <WebView
        android:id="@+id/web_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Shown until a server has been found, and when the address has to be
         changed. The address can be typed in at any time, so a television
         without a keyboard is not left without a way to reach the server. -->
    <LinearLayout
        android:id="@+id/setup_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <ImageView
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:contentDescription="@string/app_name"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/setup_title"
            android:textColor="@android:color/white"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/setup_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/setup_searching"
            android:textColor="@android:color/darker_gray"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/setup_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:autofillHints="hostname"
            android:hint="@string/setup_address_hint"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:maxLines="1"
            android:textColor="@android:color/white"
            android:textColorHint="@android:color/darker_gray"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/setup_connect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setup_connect" />

            <Button
                android:id="@+id/setup_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/setup_search" />

            <!-- Returns to the player, for when the address screen was opened
                 by mistake and the song is already playing. -->
            <Button
                android:id="@+id/setup_back_to_player"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/setup_back_to_player"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
