<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- The splash screen, served by the PiKaraoke server. -->
    <WebView
        android:id="@+id/web_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Shown until a server has been found, and when the address has to be
         changed. The address can be typed in at any time, so a television
         without a keyboard is not left without a way to reach the server.

         Everything here is sized for a television: the text is large enough
         to read from a sofa, and every button is wide enough to be picked
         out from across the room, and can be reached with the arrow keys of
         a remote. -->
    <LinearLayout
        android:id="@+id/setup_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <ImageView
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:contentDescription="@string/app_name"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/setup_title"
            android:textColor="@android:color/white"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/setup_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2"
            android:text="@string/setup_searching"
            android:textColor="@android:color/darker_gray"
            android:textSize="19sp" />

        <EditText
            android:id="@+id/setup_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:hint="@string/setup_address_hint"
            android:imeOptions="actionGo"
            android:importantForAutofill="no"
            android:inputType="text|textNoSuggestions"
            android:maxLines="1"
            android:minHeight="60dp"
            android:nextFocusDown="@+id/setup_connect"
            android:password="false"
            android:textColor="@android:color/white"
            android:textColorHint="@android:color/darker_gray"
            android:textSize="22sp" />

        <!-- The buttons share the width of the screen between them, so each
             one is a large target that the remote can land on. The row is
             put in a container of its own so the buttons can grow to fill
             it. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/setup_connect"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/button_tv"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:minHeight="64dp"
                android:nextFocusRight="@+id/setup_search"
                android:text="@string/setup_connect"
                android:textAllCaps="false"
                android:textColor="@color/tv_button_text"
                android:textSize="20sp" />

            <Button
                android:id="@+id/setup_search"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@drawable/button_tv"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:minHeight="64dp"
                android:nextFocusLeft="@+id/setup_connect"
                android:nextFocusRight="@+id/setup_back_to_player"
                android:text="@string/setup_search"
                android:textAllCaps="false"
                android:textColor="@color/tv_button_text"
                android:textSize="20sp" />

            <!-- Returns to the player, for when the address screen was opened
                 by mistake and the song is already playing. -->
            <Button
                android:id="@+id/setup_back_to_player"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@drawable/button_tv"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:minHeight="64dp"
                android:nextFocusLeft="@+id/setup_search"
                android:text="@string/setup_back_to_player"
                android:textAllCaps="false"
                android:textColor="@color/tv_button_text"
                android:textSize="20sp"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
